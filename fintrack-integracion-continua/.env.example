# Valores locales de demostración. No son credenciales de producción.
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_DB=fintrack

# El host debe ser el nombre del servicio Docker, no localhost.
DATABASE_URL=postgresql://fintrack:fintrack@db:5432/fintrack?schema=public

PORT=3000
CORS_ORIGIN=http://localhost:5173

# URL que usa el navegador. Es el puerto publicado del backend.
VITE_API_URL=http://localhost:3000
