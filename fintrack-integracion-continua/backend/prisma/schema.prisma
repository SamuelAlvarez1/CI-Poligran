generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          Int             @id @default(autoincrement())
  description String
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(18, 2)
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())

  @@map("transactions")
}
